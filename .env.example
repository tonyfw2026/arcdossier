# ArcDossier — server environment
#
# Copy this file to `.env` (or export these variables in your shell) and fill in
# a key. NEVER commit the filled-in file, and never put a key in front-end code:
# the browser must not be able to call the model directly.

# --- AI analysis layer ------------------------------------------------------
# Provider: "minimax" for a real call, "mock" to exercise the whole pipeline
# without spending any quota, "off" to disable the section entirely.
ARC_AI_PROVIDER=minimax

# Subscription key (M Plan) or a pay-as-you-go key. Either name works.
MINIMAX_API_KEY=
# ARC_AI_API_KEY=

# Anthropic-compatible is the path MiniMax documents as recommended for this
# model. Switch ARC_AI_PROTOCOL to "openai" and the base URL to
# https://api.minimax.cn/v1 to use the OpenAI-compatible route instead.
ARC_AI_PROTOCOL=anthropic
ARC_AI_BASE_URL=https://api.minimax.cn/anthropic
ARC_AI_MODEL_QUICK=MiniMax-M2.7-highspeed

# Guardrails. The public report uses the high-speed model without a reasoning
# effort field and makes at most one model request.
ARC_AI_DAILY_CALLS=30
ARC_AI_MAX_TOKENS_QUICK=2200
ARC_AI_TIMEOUT_QUICK=22
ARC_AI_PACKET_CHARS_QUICK=16000

# --- RootData ---------------------------------------------------------------
# Team identity and funding enrichment. RootData has no public API, so this only
# works with a key issued to your account. Endpoints used:
#   POST https://api.rootdata.com/open/ser_inv    (search by project name)
#   POST https://api.rootdata.com/open/get_item   (detail by numeric project_id)
# Auth is the `apikey` request header.
ROOTDATA_API_KEY=
ROOTDATA_LANGUAGE=en
ROOTDATA_DAILY_CALLS=20

# --- Arc RPC ---------------------------------------------------------------
# Override only if you need a different provider.
# ARC_RPC_MAINNET=https://rpc.mainnet.arc.io
# ARC_RPC_TESTNET=https://rpc.testnet.arc.io
